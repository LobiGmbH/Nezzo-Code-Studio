{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "types": ["node", "electron"]
  },
  "include": ["src/core/**/*.ts", "src/terminal/**/*.ts", "src/ai/**/*.ts", "src/compiler/**/*.ts", "src/languages/**/*.ts"]
}
